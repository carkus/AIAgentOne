# Every variable the backend reads. Local dev: put the same keys in env.json
# at the repo root (backend/server.py loads it on startup; see RUN.md).
# Production: /var/www/aiagent/.env on the droplet, loaded by the systemd
# units (see DEPLOY.md). Only one model provider is required; leave the rest
# unset and the features that need them switch off.

# --- Model providers -------------------------------------------------------
# Chat/bootstrap cascade: Gemini -> Cloudflare Workers AI -> Ollama. Each step
# is skipped when its credentials aren't set.
GEMINI_API_KEY=your-gemini-api-key

# Cloudflare Workers AI (hosted Qwen). Second step of the chat cascade and
# also generate_image's last fallback. The token needs the "Workers AI"
# permission; the account ID is on the Cloudflare dashboard. Free allowance is
# 10k neurons/day; once it runs out, Workers AI is skipped until 00:00 UTC.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-workers-ai-token
# CLOUDFLARE_MODELS=@cf/qwen/qwen3.8-27b

# Ollama (local only; the droplet doesn't run it for this app). Set
# OLLAMA_CONTEXT_LENGTH=16384 on the Ollama *server*, not here: it ignores the
# context size the API asks for and otherwise cuts prompts to ~2k tokens.
# LLM_PROVIDER=ollama forces local-only; DISABLE_OLLAMA=1 removes Ollama from
# the cascade and /models.
# LLM_PROVIDER=ollama
# DISABLE_OLLAMA=1
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen3:8b

# Per-call timeouts, in seconds.
# GEMINI_TIMEOUT_SECONDS=30
# CLOUDFLARE_TIMEOUT_SECONDS=90
# OLLAMA_TIMEOUT_SECONDS=180

# --- Tools -----------------------------------------------------------------
# General web search: Tavily's official remote MCP server, offered to
# bootstrap as a vetted tool only when this is set.
TAVILY_API_KEY=your-tavily-key

# generate_image fallback when Gemini isn't set or its image call fails.
# Free token at huggingface.co/settings/tokens, no billing required.
HF_API_TOKEN=your-huggingface-token

# search_jobs primitive (job-search agent type): Adzuna's API, free tier at
# developer.adzuna.com. Without these, search_jobs returns
# {"status": "no_credentials", ...}.
ADZUNA_APP_ID=your-app-id
ADZUNA_APP_KEY=your-app-key

# Sandbox limits for generated tool code (backend/src/sandbox.py). CPU,
# memory and file-size limits apply on Linux only.
# TOOL_SANDBOX_TIMEOUT_SECONDS=30
# TOOL_SANDBOX_CPU_SECONDS=15
# TOOL_SANDBOX_MEMORY_MB=512
# TOOL_SANDBOX_FILE_MB=20
# TOOL_HTTP_TIMEOUT_SECONDS=20
# MCP_CALL_TIMEOUT_SECONDS=25

# --- Servers ---------------------------------------------------------------
# PORT is backend/server.py's, MCP_PORT backend/mcp_server.py's. DATA_DIR
# holds agentone.db. With MCP_API_KEY unset /mcp is open; set it and clients
# must send it as an X-Api-Key header (or ?key=).
# PORT=4891
# MCP_PORT=4892
# DATA_DIR=./data
# MCP_API_KEY=your-mcp-key

# Per-IP rate limits: RATE_LIMIT_* for /bootstrap and /agent, BRIEF_* for the
# Setup screen's brief calls. Requests with provider=ollama are exempt.
# RATE_LIMIT_PER_MINUTE=5
# RATE_LIMIT_PER_DAY=50
# BRIEF_RATE_LIMIT_PER_MINUTE=20
# BRIEF_RATE_LIMIT_PER_DAY=300

# --- Frontend (frontend/.env.local) ----------------------------------------
# Leave empty for local dev: the Vite proxy sends API routes to localhost:4891.
VITE_API_URL=

# ChattyPrayers AI gateway: when set, chat calls go through it first (Cloudflare
# first by default) and fall back to local Ollama / Workers AI if it's down.
# Locally in Development no key is needed.
# CHATTY_GATEWAY_URL=http://localhost:5131
# CHATTY_GATEWAY_KEY=your-gateway-key
# CHATTY_GATEWAY_POLICY=cloudflare
